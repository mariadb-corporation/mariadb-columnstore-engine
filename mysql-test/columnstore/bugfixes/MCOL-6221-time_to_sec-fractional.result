DROP DATABASE IF EXISTS mcol_6221_2;
CREATE DATABASE mcol_6221_2;
USE mcol_6221_2;
CREATE TABLE t1 (t TIME(6)) ENGINE=ColumnStore;
INSERT INTO t1 VALUES
('00:00:09.900000'),
('00:00:01.500000'),
('10:50:40.123456'),
('-00:00:09.500000'),
('-00:00:00.250000');
SELECT t, TIME_TO_SEC(t) r FROM t1 ORDER BY r;
t	r
-00:00:09.500000	-9.500000
-00:00:00.250000	-0.250000
00:00:01.500000	1.500000
00:00:09.900000	9.900000
10:50:40.123456	39040.123456
CREATE TABLE t2 (d DATETIME(6)) ENGINE=ColumnStore;
INSERT INTO t2 VALUES ('1997-12-12 22:12:02.500000');
SELECT d, TIME_TO_SEC(d) r FROM t2;
d	r
1997-12-12 22:12:02.500000	79922.500000
CREATE TABLE t3 (col_float FLOAT, col_double DOUBLE) ENGINE=ColumnStore;
INSERT INTO t3 VALUES (1.5,1.5),(-1.5,-1.5),(0.25,0.25),(90.125,90.125),(3661.5,3661.5),(-3661.5,-3661.5);
SELECT TIME_TO_SEC(SEC_TO_TIME(col_float)) rf, TIME_TO_SEC(SEC_TO_TIME(col_double)) rd FROM t3 ORDER BY rf;
rf	rd
-3661.500000	-3661.500000
-1.500000	-1.500000
0.250000	0.250000
1.500000	1.500000
90.125000	90.125000
3661.500000	3661.500000
CREATE TABLE t4 (t TIME) ENGINE=ColumnStore;
INSERT INTO t4 VALUES ('01:00:00'),('22:12:02');
SELECT t, TIME_TO_SEC(t) r FROM t4 ORDER BY r;
t	r
01:00:00	3600
22:12:02	79922
CREATE TABLE t5 (t TIME(6)) ENGINE=ColumnStore;
INSERT INTO t5 VALUES
('00:00:09.500000'),
('00:00:01.250000'),
('-00:00:00.750000');
SELECT t, TIME_TO_SEC(t) + 0.0e0 AS d FROM t5 ORDER BY d;
t	d
-00:00:00.750000	-0.75
00:00:01.250000	1.25
00:00:09.500000	9.5
SET columnstore_double_for_decimal_math=1;
SELECT t, TIME_TO_SEC(t) + 0.0 AS ld FROM t5 ORDER BY ld;
t	ld
-00:00:00.750000	-0.750000
00:00:01.250000	1.250000
00:00:09.500000	9.500000
SET columnstore_double_for_decimal_math=DEFAULT;
SET time_zone='+00:00';
CREATE TABLE t6 (ts TIMESTAMP(6)) ENGINE=ColumnStore;
INSERT INTO t6 VALUES
('2020-01-15 10:50:40.123456'),
('2020-06-15 00:00:01.500000'),
('2020-06-15 23:59:59.999999');
SELECT ts, TIME_TO_SEC(ts) r FROM t6 ORDER BY r;
ts	r
