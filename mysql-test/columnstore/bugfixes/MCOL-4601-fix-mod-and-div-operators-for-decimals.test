--source ../include/have_columnstore.inc
--disable_warnings
DROP DATABASE IF EXISTS mcol_4601;
--enable_warnings
CREATE DATABASE mcol_4601;
USE mcol_4601;

### MOD operator

## Narrow DECIMAL

# Common cases (dividend's scale >= divisor's scale)
CREATE TABLE t1 (a DECIMAL(18,2)) ENGINE=ColumnStore;
INSERT INTO t1 VALUES
    (1.21),(12.1),(3.33),(99.99),(9999999999999999.99),(9999999999999999.00),
    (1000000000000000.01);
SELECT a, a MOD 0 as r FROM t1;
SELECT a, a MOD 0.01 as r FROM t1;
SELECT a, a MOD -0.01 as r FROM t1;
SELECT a, a MOD 1.1 as r FROM t1;
SELECT a, a MOD -1.1 as r FROM t1;
SELECT a, a MOD 1.11 as r FROM t1;
SELECT a, a MOD 3.33 as r FROM t1;
SELECT a, a MOD -3.33 as r FROM t1;
SELECT a, a MOD 9999999999999999.98 as r FROM t1;
SELECT a, a MOD -9999999999999999.98 as r FROM t1;

# Common cases (dividend's scale < divisor's scale)
CREATE TABLE t2 (a DECIMAL(18,1)) ENGINE=ColumnStore;
INSERT INTO t2 VALUES (1.1),(12.1),(9999999999999.0),(9999999999999.9),(1000000000000.1),(-1000000000000.1);
SELECT a, a MOD 0.03 as r from t2;
SELECT a, a MOD -0.03 as r from t2;
SELECT a, a MOD 0.75 as r from t2;
SELECT a, a MOD 1.59 as r from t2;
SELECT a, a MOD 0.041 as r from t2;
SELECT a, a MOD 1.125 as r from t2;
SELECT a, a MOD 0.333 as r from t2;
SELECT a, a MOD -0.333 as r from t2;
SELECT a, a MOD 99999999999999.999 as r from t2;
SELECT a, a MOD -99999999999999.999 as r from t2;

# When scaling up could overflow int64: DECIMAL(18,0) MOD DECIMAL(x,2)
CREATE TABLE t3 (a DECIMAL(18,0)) ENGINE=ColumnStore;
INSERT INTO t3 VALUES (999999999999999999),(123456789012345678);
SELECT a, a MOD 1.11 as r FROM t3;
SELECT a, a MOD 9999999999999999.98 as r FROM t3;

# Divisor > dividend: result = dividend
CREATE TABLE t4 (a DECIMAL(18,2)) ENGINE=ColumnStore;
INSERT INTO t4 VALUES (0.50),(1.00),(0.01),(0.00);
SELECT a, a MOD 1.11 as r FROM t4;
SELECT a, a MOD 9999999999999999.99 as r FROM t4;
SELECT a, a MOD -9999999999999999.99 as r FROM t4;

# Case when the result is converted to some other type than DECIMAL
SELECT a, ROUND(SQRT(a MOD 1.1), 2) as r FROM t1; # second param is a decimal
SELECT a, ROUND(SQRT(a MOD 11), 2) as r FROM t1;  # second param is an int

## Wide DECIMAL

# Both scales are zero, a separate branch in code
CREATE TABLE t5 (a DECIMAL(38,0)) ENGINE=ColumnStore;
INSERT INTO t5 VALUES (1),(2),(3);
SELECT a, a MOD 2 FROM t5;

# Common cases (dividend's scale >= divisor's scale)
CREATE TABLE t6 (a DECIMAL(38,2)) ENGINE=ColumnStore;
INSERT INTO t6 VALUES
    (1.21),(12.1),(3.33),(99.99),(999999999999999999999999999999999999.99),(999999999999999999999999999999999999.00),
    (100000000000000000000000000000000000.01);
SELECT a, a MOD 0 as r FROM t6;
SELECT a, a MOD 0.01 as r FROM t6;
SELECT a, a MOD -0.01 as r FROM t6;
SELECT a, a MOD 1.1 as r FROM t6;
SELECT a, a MOD -1.1 as r FROM t6;
SELECT a, a MOD 1.11 as r FROM t6;
SELECT a, a MOD 3.33 as r FROM t6;
SELECT a, a MOD -3.33 as r FROM t6;
SELECT a, a MOD 9999999999999999.98 as r FROM t6;
SELECT a, a MOD -9999999999999999.98 as r FROM t6;

# Common cases (dividend's scale < divisor's scale)
CREATE TABLE t7 (a DECIMAL(38,1)) ENGINE=ColumnStore;
INSERT INTO t7 VALUES (1.1),(12.1),(999999999999999999999999999999999.0),(999999999999999999999999999999999.9),
(100000000000000000000000000000000.1),(-100000000000000000000000000000000.1);
SELECT a, a MOD 0.03 as r from t7;
SELECT a, a MOD -0.03 as r from t7;
SELECT a, a MOD 0.75 as r from t7;
SELECT a, a MOD 1.59 as r from t7;
SELECT a, a MOD 0.041 as r from t7;
SELECT a, a MOD 1.125 as r from t7;
SELECT a, a MOD 0.333 as r from t7;
SELECT a, a MOD -0.333 as r from t7;
SELECT a, a MOD 99999999999999.999 as r from t7;
SELECT a, a MOD -99999999999999.999 as r from t7;

# TODO: Need to handle overflow, expect out-of-range error when scaling could overflow int128: DECIMAL(38,0) MOD DECIMAL(x,2)
CREATE TABLE t8 (a DECIMAL(38,0)) ENGINE=ColumnStore;
INSERT INTO t8 VALUES (99999999999999999999999999999999999999),(12345678901234567899999999999999999999);
SELECT a, a MOD 1.11 as r FROM t8;

# Divisor > dividend: result = dividend
CREATE TABLE t9 (a DECIMAL(38,2)) ENGINE=ColumnStore;
INSERT INTO t9 VALUES (0.50),(1.00),(0.01),(0.00);
SELECT a, a MOD 1.11 as r FROM t9;
SELECT a, a MOD 999999999999999999999999999999999999.99 as r FROM t9;
SELECT a, a MOD -999999999999999999999999999999999999.99 as r FROM t9;

# Case when the result is converted to some other type than DECIMAL
SELECT a, ROUND(SQRT(a MOD 1.1), 2) as r FROM t6; # second param is a decimal
SELECT a, ROUND(SQRT(a MOD 11), 2) as r FROM t6;  # second param is an int

### DIV operator

## Narrow DECIMAL

# Common cases (dividend's scale >= divisor's scale)
# Reusing t1: DECIMAL(18,2)
SELECT a, a DIV 0 as r FROM t1;
SELECT a, a DIV 0.01 as r FROM t1;
SELECT a, a DIV -0.01 as r FROM t1;
SELECT a, a DIV 1.1 as r FROM t1;
SELECT a, a DIV -1.1 as r FROM t1;
SELECT a, a DIV 1.11 as r FROM t1;
SELECT a, a DIV 3.33 as r FROM t1;
SELECT a, a DIV -3.33 as r FROM t1;
SELECT a, a DIV 9999999999999999.98 as r FROM t1;
SELECT a, a DIV -9999999999999999.98 as r FROM t1;

# Common cases (dividend's scale < divisor's scale)
# Reusing t2: DECIMAL(18,1)
SELECT a, a DIV 0.03 as r FROM t2;
SELECT a, a DIV -0.03 as r FROM t2;
SELECT a, a DIV 0.75 as r FROM t2;
SELECT a, a DIV 1.59 as r FROM t2;
SELECT a, a DIV 0.041 as r FROM t2;
SELECT a, a DIV 1.125 as r FROM t2;
SELECT a, a DIV 0.333 as r FROM t2;
SELECT a, a DIV -0.333 as r FROM t2;
SELECT a, a DIV 99999999999999.999 as r FROM t2;
SELECT a, a DIV -99999999999999.999 as r FROM t2;

# When scaling up could overflow int64: DECIMAL(18,0) DIV DECIMAL(x,2)
# Reusing t3: DECIMAL(18,0)
SELECT a, a DIV 1.11 as r FROM t3;

# Divisor > dividend: result = 0
# Reusing t4: DECIMAL(18,2)
SELECT a, a DIV 1.11 as r FROM t4;
SELECT a, a DIV 9999999999999999.99 as r FROM t4;
SELECT a, a DIV -9999999999999999.99 as r FROM t4;

# Unsigned division
CREATE TABLE t41 (a DECIMAL(18,2) UNSIGNED) ENGINE=ColumnStore;
INSERT INTO t41 VALUES (1.21),(12.1),(3.33),(99.99),(9999999999999999.99),
    (9999999999999999.00), (1000000000000000.01);
SELECT a, a DIV 0 as r FROM t41;
SELECT a, a DIV 1.1 as r FROM t41;
SELECT a, a DIV 9999999999999999.98 as r FROM t41;

## Wide DECIMAL

# Both scales are zero
# Reusing t5: DECIMAL(38,0)
SELECT a, a DIV 2 FROM t5;

# Common cases (dividend's scale >= divisor's scale)
# Reusing t6: DECIMAL(38,2)
SELECT a, a DIV 0 as r FROM t6;
SELECT a, a DIV 999999999999999912.98 as r FROM t6;
SELECT a, a DIV -999999999999999912.98 as r FROM t6;
# TODO: dividing large wide decimal by a small value could overflow
SELECT a, a DIV 1.1 as r FROM t6;
SELECT a, a DIV -1.1 as r FROM t6;
SELECT a, a DIV 1.11 as r FROM t6;
SELECT a, a DIV 3.33 as r FROM t6;
SELECT a, a DIV -3.33 as r FROM t6;

# Common cases (dividend's scale < divisor's scale)
# Reusing t7: DECIMAL(38,1)
SELECT a, a DIV 9999999999999912.999 as r FROM t7;
SELECT a, a DIV -9999999999999912.999 as r FROM t7;
# TODO: dividing large wide decimal by a small value could overflow
SELECT a, a DIV 0.03 as r FROM t7;
SELECT a, a DIV -0.03 as r FROM t7;
SELECT a, a DIV 0.75 as r FROM t7;
SELECT a, a DIV 1.59 as r FROM t7;
SELECT a, a DIV 0.041 as r FROM t7;
SELECT a, a DIV 1.125 as r FROM t7;
SELECT a, a DIV 0.333 as r FROM t7;
SELECT a, a DIV -0.333 as r FROM t7;

# TODO: Expect out-of-range error when scaling up could overflow int128: DECIMAL(38,0) DIV DECIMAL(x,2)
# Reusing t8: DECIMAL(38,0)
SELECT a, a DIV 1.11 as r FROM t8;
SELECT a, a DIV 0.01 as r FROM t8;

# Divisor > dividend: result = 0
# Reusing t9: DECIMAL(38,2)
SELECT a, a DIV 1.11 as r FROM t9;
SELECT a, a DIV 999999999999999999999999999999999999.99 as r FROM t9;
SELECT a, a DIV -999999999999999999999999999999999999.99 as r FROM t9;

# Unsigned division
CREATE TABLE t91 (a DECIMAL(38,2) UNSIGNED) ENGINE=ColumnStore;
INSERT INTO t91 VALUES
    (1.21),(12.1),(3.33),(99.99),(999999999999999999999999999999999999.99),(999999999999999999999999999999999999.00),
    (100000000000000000000000000000000000.01);
SELECT a, a DIV 0 as r FROM t91;
SELECT a, a DIV 47300000000000000000001.1 as r FROM t91;
SELECT a, a DIV 999999999999999999999999999999999999.98 as r FROM t91;
# TODO: dividing large wide decimal by a small value could overflow
SELECT a, a DIV 1.1 as r FROM t91;
SELECT a, a DIV 0.01 as r FROM t91;

# Cleanup
DROP DATABASE mcol_4601;
