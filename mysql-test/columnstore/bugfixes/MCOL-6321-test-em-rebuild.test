INSERT INTO t(x) SELECT CONCAT(seq, REPEAT('zuka',1000000)) FROM seq_531_to_540;
INSERT INTO t(x) SELECT CONCAT(seq, REPEAT('zuka',1000000)) FROM seq_541_to_550;
