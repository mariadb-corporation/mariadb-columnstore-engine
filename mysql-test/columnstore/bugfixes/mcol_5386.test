-- source ../include/have_columnstore.inc
--disable_warnings
DROP DATABASE IF EXISTS mcol_5386;
--enable_warnings
CREATE DATABASE mcol_5386;
USE mcol_5386;

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1(c DECIMAL(19)) engine=columnstore;
INSERT INTO t1 VALUES (-2);
SELECT 'case1', BIT_OR(c), BIT_XOR(c), BIT_AND(c) FROM t1;
DROP TABLE t1;

CREATE TABLE t1(c DECIMAL(19)) engine=columnstore;
INSERT INTO t1 VALUES (-2), (0), (7), (NULL), (-8);
SELECT 'case2', BIT_OR(c), BIT_XOR(c), BIT_AND(c) FROM t1;
DROP TABLE t1;

CREATE TABLE t1(c DECIMAL(38)) engine=columnstore;
INSERT INTO t1 VALUES (11111111111111111111111111111111111111);
SELECT 'case3', BIT_OR(c), BIT_XOR(c), BIT_AND(c) FROM t1;
DROP TABLE t1;

CREATE TABLE t1(c DECIMAL(38)) engine=columnstore;
INSERT INTO t1 VALUES (-11111111111111111111111111111111111111);
SELECT 'case4', BIT_OR(c), BIT_XOR(c), BIT_AND(c) FROM t1;
DROP TABLE t1;

CREATE TABLE t1(c DECIMAL(19,4)) engine=columnstore;
INSERT INTO t1 VALUES (123.6), (-123.6), (0.4), (-0.4), (NULL);
SELECT 'case5', BIT_OR(c), BIT_XOR(c), BIT_AND(c) FROM t1;
DROP TABLE t1;

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

--disable_warnings
DROP DATABASE mcol_5386;
--enable_warnings
