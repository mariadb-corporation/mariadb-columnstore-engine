--source ../include/have_columnstore.inc
--source ../include/functions.inc
--disable_warnings
DROP DATABASE IF EXISTS mcol_5430;
--enable_warnings
CREATE DATABASE mcol_5430 ;
USE mcol_5430 ;

CREATE TABLE empsalary (
    depname VARCHAR(100),
    empno BIGINT,
    salary INT,
    enroll_date DATE
)ENGINE=ColumnStore;
 
INSERT INTO empsalary VALUES ('develop'  , 10, 5200, '2007-08-01'),
                             ('sales'    ,  1, 4800, '2006-10-01'),
                             ('personnel',  5, 3900, '2007-12-10'),
                             ('sales'    ,  4, 4800, '2007-08-08'),
                             ('personnel',  2, 3900, '2006-12-23'),
                             ('develop'  ,  7, 5200, '2008-01-01'),
                             ('develop'  ,  9, 5200, '2008-01-01'),
                             ('sales'    ,  3, 4800, '2007-08-01'),
                             ('develop'  ,  8, 5200, '2006-10-01'),
                             ('develop'  , 11, 5200, '2007-08-15'),
                             ('develop'  , 12, 5200, '2008-08-09');

SELECT AVG(salary), depname, MODA(salary) OVER(PARTITION BY depname ORDER BY enroll_date)
FROM empsalary
GROUP BY depname
ORDER BY depname;

DROP DATABASE mcol_5430 ;

