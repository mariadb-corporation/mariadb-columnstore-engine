--disable_warnings
DROP DATABASE IF EXISTS mcol6574;
--enable_warnings

CREATE DATABASE mcol6574;
CREATE TABLE cs1 (a DATETIME) ENGINE=COLUMNSTORE;

INSERT INTO cs1 VALUES("2025-04-03 20:36:42");
SET @@session.time_zone = "+01:00";
SELECT UNIX_TIMESTAMP(a) FROM cs1;
# expect 1743701802
SET @@session.time_zone = "+00:00";
SELECT UNIX_TIMESTAMP(a) FROM cs1;
# expect 1743712602

DROP DATABASE mcol6574;
