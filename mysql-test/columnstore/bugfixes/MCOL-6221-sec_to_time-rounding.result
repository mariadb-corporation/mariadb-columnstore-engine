DROP DATABASE IF EXISTS mcol_6221;
CREATE DATABASE mcol_6221;
USE mcol_6221;
CREATE TABLE t1(a FLOAT) ENGINE=ColumnStore;
INSERT INTO t1 VALUES (1.5),(-1.5),(0.25),(90.125),(3661.5),(-3661.5);
SELECT a, SEC_TO_TIME(a) FROM t1 ORDER BY a;
a	SEC_TO_TIME(a)
-3661.5	-01:01:01.500000
-1.5	-00:00:01.500000
0.25	00:00:00.250000
1.5	00:00:01.500000
90.125	00:01:30.125000
3661.5	01:01:01.500000
CREATE TABLE t2(a DOUBLE) ENGINE=ColumnStore;
INSERT INTO t2 VALUES (1.5),(-1.5),(0.25),(90.125),(3661.5),(-3661.5);
SELECT a, SEC_TO_TIME(a) FROM t2 ORDER BY a;
a	SEC_TO_TIME(a)
-3661.5	-01:01:01.500000
-1.5	-00:00:01.500000
0.25	00:00:00.250000
1.5	00:00:01.500000
90.125	00:01:30.125000
3661.5	01:01:01.500000
CREATE TABLE t3(a DECIMAL(12,2)) ENGINE=ColumnStore;
INSERT INTO t3 VALUES (1.50),(-1.50),(111.99),(3661.25);
SELECT a, SEC_TO_TIME(a) FROM t3 ORDER BY a;
a	SEC_TO_TIME(a)
-1.50	-00:00:01.50
1.50	00:00:01.50
111.99	00:01:51.99
3661.25	01:01:01.25
CREATE TABLE t4(a DOUBLE) ENGINE=ColumnStore;
INSERT INTO t4 VALUES (1234567890.1),(-1234567890.1);
SELECT a, SEC_TO_TIME(a) FROM t4 ORDER BY a;
a	SEC_TO_TIME(a)
-1234567890.1	-838:59:59.999999
1234567890.1	838:59:59.999999
CREATE TABLE t5(a DOUBLE) ENGINE=ColumnStore;
INSERT INTO t5 VALUES (1.5),(-1.5),(90.125),(3661.5);
SELECT a, SEC_TO_TIME(a) + 0.0e0 FROM t5 ORDER BY a;
a	SEC_TO_TIME(a) + 0.0e0
-1.5	-1.5
1.5	1.5
90.125	130.125
3661.5	10101.5
SET columnstore_double_for_decimal_math=1;
CREATE TABLE t6(a DOUBLE) ENGINE=ColumnStore;
INSERT INTO t6 VALUES (1.5),(-1.5),(90.125),(3661.5);
SELECT a, SEC_TO_TIME(a) + 0.0 FROM t6 ORDER BY a;
