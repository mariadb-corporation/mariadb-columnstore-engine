#
# MDEV-37484: `Sql_cmd_dml::execute_inner`, `Sql_cmd_update::execute_inner` do not call Select handler for the engine involved
#
DROP DATABASE IF EXISTS tcs;
CREATE DATABASE tcs;
USE tcs;
create table product_tag (product_id bigint) engine=columnstore;
insert into product_tag values (1),(2),(3),(4);
CREATE TABLE `product` (
`product_id` bigint(20) DEFAULT NULL,
`price` bigint(20) DEFAULT NULL,
`short_description` varchar(7998) DEFAULT NULL,
`brand` varchar(254) DEFAULT NULL,
`modified_dtm` datetime DEFAULT NULL,
`created_dtm` datetime DEFAULT NULL,
`modified_by` int(11) DEFAULT NULL
) engine=columnstore DEFAULT CHARSET=latin1;
insert into product values (1,22,'fes','rets','2011-12-12 12:12:12','2011-12-13 1:1:10',343);
insert into product values (3,22,'fes','rets','2011-12-12 12:12:12','2011-12-13 1:1:10',343);
select * from product order by product_id;
product_id	price	short_description	brand	modified_dtm	created_dtm	modified_by
1	22	fes	rets	2011-12-12 12:12:12	2011-12-13 01:01:10	343
3	22	fes	rets	2011-12-12 12:12:12	2011-12-13 01:01:10	343
explain format=json update
product p join
(select product_id from product_tag limit 1000) t using (product_id)
set brand=p.product_id, price=555, modified_dtm='2011-12-15 15:15:30',
short_description=concat(short_description,modified_by);
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "table": {
      "message": "Pushed select"
    }
  }
}
update
product p join
(select product_id from product_tag limit 1000) t using (product_id)
set brand=p.product_id, price=555, modified_dtm='2011-12-15 15:15:30',
short_description=concat(short_description,modified_by);
select * from product order by product_id;
product_id	price	short_description	brand	modified_dtm	created_dtm	modified_by
1	555	fes343	1	2011-12-15 15:15:30	2011-12-13 01:01:10	343
3	555	fes343	3	2011-12-15 15:15:30	2011-12-13 01:01:10	343
explain format=json update
product p join product_tag t using (product_id)
set brand=p.product_id, price=666, modified_dtm='2011-12-15 15:15:30',
short_description=concat(short_description,modified_by);
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "table": {
      "message": "Pushed select"
    }
  }
}
update
product p join product_tag t using (product_id)
set brand=p.product_id, price=666, modified_dtm='2011-12-15 15:15:30',
short_description=concat(short_description,modified_by);
select * from product order by product_id;
product_id	price	short_description	brand	modified_dtm	created_dtm	modified_by
1	666	fes343343	1	2011-12-15 15:15:30	2011-12-13 01:01:10	343
3	666	fes343343	3	2011-12-15 15:15:30	2011-12-13 01:01:10	343
drop table product, product_tag;
# Update tests
create table t1 (id int) engine=columnstore;
insert into t1 values (1),(2),(3),(4);
create table t2 (id int, op varchar(10), op_count int DEFAULT 0) engine=columnstore DEFAULT CHARSET=latin1;
insert into t2 (id, op) values (1, 'inserted'), (2, 'inserted'), (3, 'inserted'), (4, 'inserted');
select * from t2 order by id;
id	op	op_count
1	inserted	0
2	inserted	0
3	inserted	0
4	inserted	0
explain format=json update t2 inner join t1 on t2.id = t1.id
set t2.op = 'updated', t2.op_count = t2.op_count + 1
where t2.id in (1, 2);
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "table": {
      "message": "Pushed select"
    }
  }
}
update t2 inner join t1 on t2.id = t1.id
set t2.op = 'updated', t2.op_count = t2.op_count + 1
where t2.id in (1, 2);
select * from t2 order by id;
id	op	op_count
1	updated	1
2	updated	1
3	inserted	0
4	inserted	0
# Prepared update stmt test
PREPARE stmt_update FROM
'update t2 inner join t1 on t2.id = t1.id set t2.op_count = t2.op_count + 1, t2.op = ? where t2.id in (1, 2)';
SET @update_value = 'updated';
EXECUTE stmt_update USING @update_value;
DEALLOCATE PREPARE stmt_update;
select * from t2 order by id;
id	op	op_count
1	updated	2
2	updated	2
3	inserted	0
4	inserted	0
# Delete tests
explain format=json
delete t2 from t2 inner join t1 on t2.id = t1.id and t2.op = 'updated';
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "table": {
      "message": "Pushed select"
    }
  }
}
delete t2 from t2 inner join t1 on t2.id = t1.id and t2.op = 'updated';
select * from t2 order by id;
id	op	op_count
3	inserted	0
4	inserted	0
# Prepared delete stmts
PREPARE del_stmt FROM
'delete t2 from t2 inner join t1 on t2.id = t1.id and t2.id=3';
EXECUTE del_stmt;
DEALLOCATE PREPARE del_stmt;
select * from t2 order by id;
id	op	op_count
4	inserted	0
drop table t1;
drop table t2;
DROP DATABASE tcs;
# End of MEDV-37484 tests
