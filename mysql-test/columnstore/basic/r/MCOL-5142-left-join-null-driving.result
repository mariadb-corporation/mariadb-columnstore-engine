DROP DATABASE IF EXISTS MCOL5142_LEFT_JOIN;
CREATE DATABASE MCOL5142_LEFT_JOIN;
USE MCOL5142_LEFT_JOIN;
CREATE TABLE nodes (
id INT NOT NULL,
next_id INT NULL
);
INSERT INTO nodes VALUES
(1,2),
(2,3),
(3,NULL),
(4,99);
WITH RECURSIVE walk AS (
SELECT id, next_id, 0 AS lvl
FROM nodes
WHERE id IN (1,4)
UNION ALL
SELECT w.next_id AS id, n.next_id, w.lvl + 1
FROM walk w
LEFT JOIN nodes n ON n.id = w.next_id
WHERE w.next_id IS NOT NULL
)
SELECT * FROM walk;
id	next_id	lvl
1	2	0
4	99	0
2	3	1
99	NULL	1
3	NULL	2
DROP DATABASE MCOL5142_LEFT_JOIN;
