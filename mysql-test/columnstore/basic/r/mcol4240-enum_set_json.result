CREATE TABLE t (
status ENUM('active', 'inactive', 'deleted') DEFAULT 'active',
options SET('a', 'b', 'c', 'd') DEFAULT 'a,b',
info JSON DEFAULT '{}'
) ENGINE=columnstore;
INSERT INTO t (status, options)
VALUES ('active', 'a,b');
SELECT * FROM t;
status	options	info
active	a,b	{}
