DROP DATABASE IF EXISTS mcol5283;
CREATE DATABASE mcol5283;
USE mcol5283;
CREATE TABLE cs (
chr  CHAR(64),
vch  VARCHAR(255),
txt  TEXT,
blb  BLOB,
dat  DATE,
tim  TIME,
tms  TIME(6),
dt   DATETIME,
dtms DATETIME(6),
ts   TIMESTAMP,
tsms TIMESTAMP(6)
) ENGINE=ColumnStore;
