DROP DATABASE IF EXISTS test_linear_rec;
CREATE DATABASE test_linear_rec;
USE test_linear_rec;
CREATE TABLE t_linear (id INT) ENGINE=ColumnStore;
INSERT INTO t_linear VALUES (1), (2), (3);
WITH RECURSIVE cte AS (
SELECT id
FROM t_linear
WHERE id = 1
UNION ALL
SELECT t.id
FROM t_linear t
JOIN cte c ON t.id = c.id + 1
)
SELECT * FROM cte;
id
1
2
3
WITH RECURSIVE cte AS (
SELECT id
FROM t_linear
WHERE id = 1
UNION ALL
SELECT t.id
FROM t_linear t
JOIN cte c ON t.id = c.id + 1
)
SELECT COUNT(*) FROM cte;
COUNT(*)
3
DROP DATABASE test_linear_rec;
