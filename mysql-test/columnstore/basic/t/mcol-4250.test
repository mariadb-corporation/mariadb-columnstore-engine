--source ../include/have_columnstore.inc

--echo # MCOL-4250
--echo # Correlated scalar aggregate subqueries inside an OUTER JOIN ON clause
--echo # are now decorrelated by the RBO rule `decorrelate_outer_join_sub`:
--echo # the inner SELECT is promoted to a derived table (GROUP BY on the
--echo # correlation keys) and the enclosing SelectFilter is replaced with
--echo # equi-join predicates referencing that derived table.  For every
--echo # supported shape Columnstore must now execute the query directly and
--echo # produce the same result set as the MariaDB (AUTO) fallback path.

SET default_storage_engine=columnstore;

--disable_warnings
DROP DATABASE IF EXISTS mcol4250;
CREATE DATABASE mcol4250;
USE mcol4250;

# Schema reduced from the ticket. Types simplified so the repro fits the
# minimal join shape that triggers the IDB-1015 path in buildJoin().
CREATE TABLE cas_triggerevent(
  ASSOCIATED_BCAP_CASEID INT,
  SOURCE_DB INT
) ENGINE=columnstore;

CREATE TABLE cas_case(
  CASEID INT,
  ASSOCIATED_BCAP_CASEID INT,
  SOURCE_DB INT,
  REQUESTTYPECODE VARCHAR(100),
  GCIN INT
) ENGINE=columnstore;

CREATE TABLE cas_bcapkyc(
  CASEID INT,
  SOURCE_DB INT,
  gcin1 INT
) ENGINE=columnstore;

CREATE TABLE cas_caseflow(
  CASEID INT,
  SOURCE_DB INT,
  STATUSCODE VARCHAR(100),
  INDATE DATE
) ENGINE=columnstore;

INSERT INTO cas_triggerevent VALUES (1, 1), (2, 1);
INSERT INTO cas_case VALUES
  (1, 1, 1, 'CBGBranchesRequest', 100),
  (2, 2, 1, 'BCAPApplication',    200),
  (3, 3, 1, 'OtherType',          300);
INSERT INTO cas_bcapkyc VALUES (1, 1, 100), (2, 1, 200);
INSERT INTO cas_caseflow VALUES
  (1, 1, 'CompletedScreening', '2024-01-01'),
  (1, 1, 'CompletedScreening', '2024-02-01'),
  (2, 1, 'CompletedScreening', '2024-03-01');

--echo #
--echo # 1. Minimal scalar correlated subquery in LEFT JOIN ON (the actual
--echo #    pattern from MCOL-4250).
--echo #
SET columnstore_select_handler=ON;
--sorted_result
SELECT cc.CASEID
FROM cas_case cc
LEFT JOIN cas_caseflow cf
  ON cc.CASEID = cf.CASEID
 AND cc.SOURCE_DB = cf.SOURCE_DB
 AND cf.STATUSCODE = 'CompletedScreening'
 AND cf.INDATE = (SELECT MAX(e.INDATE)
                  FROM cas_caseflow e
                  WHERE e.CASEID    = cf.CASEID
                    AND e.SOURCE_DB = cf.SOURCE_DB
                    AND e.STATUSCODE = cf.STATUSCODE);

SET columnstore_select_handler=AUTO;
--sorted_result
SELECT cc.CASEID
FROM cas_case cc
LEFT JOIN cas_caseflow cf
  ON cc.CASEID = cf.CASEID
 AND cc.SOURCE_DB = cf.SOURCE_DB
 AND cf.STATUSCODE = 'CompletedScreening'
 AND cf.INDATE = (SELECT MAX(e.INDATE)
                  FROM cas_caseflow e
                  WHERE e.CASEID    = cf.CASEID
                    AND e.SOURCE_DB = cf.SOURCE_DB
                    AND e.STATUSCODE = cf.STATUSCODE);

--echo #
--echo # 2. Full repro from the ticket via a VIEW.
--echo #
CREATE VIEW vw_triggerevent_assoc_bcap_cases AS
SELECT cc.CASEID AS CASEID
FROM cas_triggerevent ct
JOIN cas_case cc
  ON ct.ASSOCIATED_BCAP_CASEID = cc.CASEID
 AND ct.SOURCE_DB              = cc.SOURCE_DB
JOIN cas_bcapkyc cb
  ON cb.CASEID    = cc.CASEID
 AND cb.SOURCE_DB = cc.SOURCE_DB
 AND cb.gcin1     = cc.GCIN
LEFT JOIN cas_caseflow cf
  ON cc.CASEID    = cf.CASEID
 AND cc.SOURCE_DB = cf.SOURCE_DB
 AND cf.STATUSCODE = 'CompletedScreening'
 AND cf.INDATE = (SELECT MAX(e.INDATE)
                  FROM cas_caseflow e
                  WHERE e.CASEID    = cf.CASEID
                    AND e.SOURCE_DB = cf.SOURCE_DB
                    AND e.STATUSCODE = cf.STATUSCODE)
WHERE cc.REQUESTTYPECODE IN ('CBGBranchesRequest','BCAPApplication');

SET columnstore_select_handler=ON;
SELECT * FROM vw_triggerevent_assoc_bcap_cases ORDER BY CASEID;

DROP VIEW vw_triggerevent_assoc_bcap_cases;
DROP TABLE cas_triggerevent;
DROP TABLE cas_case;
DROP TABLE cas_bcapkyc;
DROP TABLE cas_caseflow;
DROP DATABASE mcol4250;
--enable_warnings
