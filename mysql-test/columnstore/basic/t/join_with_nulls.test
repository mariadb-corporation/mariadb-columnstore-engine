--echo ==== utf8 ====
--disable_warnings
DROP TABLE IF EXISTS t_varchar;
DROP TABLE IF EXISTS t_varchar2;
--enable_warnings

CREATE TABLE t_varchar (
  v VARCHAR(10) NULL
) ENGINE=COLUMNSTORE CHARACTER SET utf8 COLLATE utf8_bin;

INSERT INTO t_varchar (v) VALUES
  (NULL),
  (''),
  ('0'),
  ('1'),
  ('123'),
  ('-5'),
  ('3.14'),
  ('abc');

CREATE TABLE t_varchar2 (
  v VARCHAR(10) NULL
) ENGINE=COLUMNSTORE CHARACTER SET utf8 COLLATE utf8_bin;

INSERT INTO t_varchar2 (v) VALUES
  (NULL),
  (''),
  ('0'),
  ('1'),
  ('123'),
  ('-5'),
  ('3.14'),
  ('abc');

SELECT QUOTE(a.v), QUOTE(b.v) FROM t_varchar a JOIN t_varchar2 b ON a.v = b.v ORDER BY a.v IS NULL, a.v, b.v;
SELECT QUOTE(a.v), QUOTE(b.v) FROM t_varchar a JOIN t_varchar b ON a.v = b.v ORDER BY a.v IS NULL, a.v, b.v;

DROP TABLE t_varchar;
DROP TABLE t_varchar2;

