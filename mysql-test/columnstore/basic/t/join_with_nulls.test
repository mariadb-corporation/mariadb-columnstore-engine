SELECT QUOTE(a.v), QUOTE(b.v) FROM t_varchar_l1 a JOIN t_varchar_l1 b ON a.v = b.v ORDER BY a.v IS NULL, a.v, b.v;

DROP TABLE t_varchar_l1;
DROP TABLE t_varchar2_l1;

