use autopilot;
--disable_query_log
SET time_zone='GMT';
--enable_query_log

START TRANSACTION;
UPDATE datatypeupdate SET CDATETIME = CTIMESTAMP;
SELECT CDATETIME FROM datatypeupdate;
ROLLBACK;
