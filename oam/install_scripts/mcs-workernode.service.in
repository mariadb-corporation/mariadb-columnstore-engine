[Unit]
Description=mcs-workernode
# Don't start on an empty image when the BRM load failed (MCOL-6606).
Requires=mcs-loadbrm.service
After=network.target mcs-loadbrm.service

[Service]
Type=forking

User=@DEFAULT_USER@
Group=@DEFAULT_GROUP@
LimitNOFILE=65536
LimitNPROC=65536
LimitCORE=@CORE_DUMPS@

Environment="@WORKERNODE_ALLOC_CONFIG@"
ExecStart=@ENGINE_BINDIR@/workernode DBRM_Worker%i
# "-": a failed save must not skip the shared memory step below, or the next
# load_brm runs against shared memory nobody decided to keep (MCOL-6608).
ExecStopPost=-@ENGINE_BINDIR@/mcs-savebrm.py
ExecStopPost=@ENGINE_BINDIR@/mcs-workernode-stop-shm.sh

Restart=on-failure
TimeoutStopSec=750

EnvironmentFile=-/etc/columnstore/systemd.env
TimeoutStopSec=900
